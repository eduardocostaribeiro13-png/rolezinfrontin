{
  "version": 1,
  "sdk_version": "0.20.1",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "rolezin-frontin-off-road",
      "version": "0.1.0",
      "title": "Rolezin Frontin Off Road"
    },
    "tools": [
      {
        "name": "list_tours",
        "title": "Listar passeios",
        "description": "Lista todos os passeios de quadriciclo oferecidos pela Rolezin Frontin Off Road, com nome, duração, nível, preço e destaques.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "get_tour",
        "title": "Detalhes do passeio",
        "description": "Retorna os detalhes completos de um passeio da Rolezin Frontin Off Road pelo slug (ex: 'trilha-do-mirante').",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1,
              "description": "Slug do passeio, ex: 'expedicao-cachoeiras'."
            }
          },
          "required": [
            "slug"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "get_contact",
        "title": "Contato e redes",
        "description": "Retorna os canais oficiais de contato da Rolezin Frontin Off Road: WhatsApp e Instagram.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "create_booking_link",
        "title": "Gerar link de reserva",
        "description": "Gera um link do WhatsApp com uma mensagem pré-preenchida para reservar um passeio. Passe o slug do passeio e, opcionalmente, data, horário e número de pessoas.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1,
              "description": "Slug do passeio."
            },
            "date": {
              "description": "Data desejada (ex: 2026-08-15).",
              "type": "string"
            },
            "time": {
              "description": "Horário desejado (ex: 09:00).",
              "type": "string"
            },
            "people": {
              "description": "Número de pessoas.",
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "name": {
              "description": "Nome do cliente.",
              "type": "string"
            }
          },
          "required": [
            "slug"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
